[Unit]
Description=Codex Telegram Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-agent
WorkingDirectory=/home/ai-agent/codex-telegram-agent
EnvironmentFile=/home/ai-agent/codex-telegram-agent/.env
ExecStart=/home/ai-agent/codex-telegram-agent/.venv/bin/python -m app.bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
